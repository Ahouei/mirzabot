# copy to .env and fill in
MIRZA_API_KEY=
MIRZA_ADMIN_NUMBER=0
MIRZA_USERNAME_BOT=
MIRZA_DOMAIN_HOSTS=localhost
MIRZA_DATABASE_URL=postgresql+asyncpg://mirza:mirza@localhost/mirza
MIRZA_WEBHOOK_SECRET=
MIRZA_SESSION_SECRET=change-me
MIRZA_TIMEZONE=Asia/Tehran
MIRZA_USE_POLLING=false
# optional
MIRZA_PORT=8080
MIRZA_MINIAPP_DIR=app
MIRZA_API_TOKENS_FILE=hash.txt
